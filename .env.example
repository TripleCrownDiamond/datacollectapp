# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://terracollect:terracollect_dev@localhost:5432/terracollect

# Storage (MinIO / S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=terracollect
STORAGE_SECRET_KEY=terracollect_dev
STORAGE_BUCKET=terracollect-media
STORAGE_PUBLIC_URL=http://localhost:9000

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production-use-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# AI (optional — only needed for AI features)
ANTHROPIC_API_KEY=

# Organization defaults
DEFAULT_MAX_FILE_SIZE_MB=25
DEFAULT_PHOTO_MAX_WIDTH=2048
