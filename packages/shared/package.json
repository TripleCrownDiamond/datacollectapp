{
  "name": "@terracollect/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "echo 'lint ok'",
    "test": "echo 'tests ok'"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@terracollect/typescript-config": "workspace:*",
    "typescript": "^5.5.0"
  }
}
